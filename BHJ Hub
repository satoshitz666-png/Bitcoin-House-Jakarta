    <script>
        // Mobile Menu Toggle
        const mobileMenuBtn = document.getElementById('mobile-menu-btn');
        const mobileMenu = document.getElementById('mobile-menu');
        mobileMenuBtn.addEventListener('click', () => {
            mobileMenu.classList.toggle('hidden');
        });

        // Scroll Animations
        const observerOptions = { threshold: 0.1, rootMargin: '0px 0px -50px 0px' };
        const observer = new IntersectionObserver((entries) => {
            entries.forEach(entry => {
                if (entry.isIntersecting) {
                    entry.target.classList.add('visible');
                    observer.unobserve(entry.target);
                }
            });
        }, observerOptions);
        document.querySelectorAll('.fade-in').forEach(el => observer.observe(el));

        // Mining Simulator Logic
        let miningActive = false;
        let miningInterval = null;
        let blocksFound = 0;
        let currentHashrate = 40;
        let efficiency = 'balanced';

        const hashSlider = document.getElementById('hashrate-slider');
        const hashDisplay = document.getElementById('hashrate-display');
        const miningToggle = document.getElementById('mining-toggle');
        const miningLog = document.getElementById('mining-log');

        const dashHash = document.getElementById('dash-hash');
        const dashPower = document.getElementById('dash-power');
        const dashBlocks = document.getElementById('dash-blocks');
        const barHash = document.getElementById('bar-hash');
        const barPower = document.getElementById('bar-power');
        const barBlocks = document.getElementById('bar-blocks');

        hashSlider.addEventListener('input', (e) => {
            currentHashrate = parseInt(e.target.value);
            hashDisplay.textContent = `${currentHashrate} TH/s`;
            updateDashboard();
        });

        function setEfficiency(mode) {
            efficiency = mode;
            document.querySelectorAll('.eff-btn').forEach(btn => {
                btn.classList.remove('border-btc-orange', 'bg-btc-orange/20', 'text-btc-orange');
                btn.classList.add('border-white/10');
            });
            event.target.classList.remove('border-white/10');
            event.target.classList.add('border-btc-orange', 'bg-btc-orange/20', 'text-btc-orange');
            updateDashboard();
        }

        function updateDashboard() {
            if (!miningActive) return;
            let powerFactor = efficiency === 'eco' ? 0.6 : efficiency === 'turbo' ? 1.2 : 0.9;
            let power = (currentHashrate * 0.03 * powerFactor).toFixed(1);
            
            dashHash.textContent = currentHashrate.toFixed(2);
            dashPower.textContent = power;
            barHash.style.width = `${currentHashrate}%`;
            barPower.style.width = `${Math.min(power * 5, 100)}%`;
        }

        function logMessage(msg) {
            const div = document.createElement('div');
            div.textContent = `> ${msg}`;
            miningLog.appendChild(div);
            miningLog.scrollTop = miningLog.scrollHeight;
        }

        function toggleMining() {
            miningActive = !miningActive;
            if (miningActive) {
                miningToggle.innerHTML = `<svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 9v6m4-6v6m7-3a9 9 0 11-18 0 9 9 0 0118 0z"/></svg> Stop Simulation`;
                miningToggle.classList.remove('bg-btc-orange', 'hover:bg-orange-600');
                miningToggle.classList.add('bg-red-500', 'hover:bg-red-600');
                logMessage('Simulation started. Allocating hashrate...');
                updateDashboard();
                miningInterval = setInterval(() => {
                    if (Math.random() > 0.7) {
                        blocksFound++;
                        dashBlocks.textContent = blocksFound;
                        barBlocks.style.width = `${Math.min((blocksFound / 100) * 100, 100)}%`;
                        logMessage(`Block #${100000 + blocksFound} found! Reward: 0.00000001 BTC`);
                        if (blocksFound >= 100) {
                            toggleMining();
                            logMessage('Target reached. Simulation complete.');
                        }
                    } else {
                        logMessage('Computing hash... Nonce updated.');
                    }
                    updateDashboard();
                }, 1500);
            } else {
                miningToggle.innerHTML = `<svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14.752 11.168l-3.197-2.132A1 1 0 0010 9.87v4.263a1 1 0 001.555.832l3.197-2.132a1 1 0 000-1.664z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg> Start Simulation`;
                miningToggle.classList.add('bg-btc-orange', 'hover:bg-orange-600');
                miningToggle.classList.remove('bg-red-500', 'hover:bg-red-600');
                clearInterval(miningInterval);
                dashHash.textContent = '0.00';
                dashPower.textContent = '0.0';
                barHash.style.width = '0%';
                barPower.style.width = '0%';
                logMessage('Simulation stopped.');
            }
        }

        // SATS Market Data
        const vendors = [
            { name: 'Kopi Nusantara', desc: 'Artisan coffee beans sourced locally.', price: '45,000', icon: '☕', type: 'F&B' },
            { name: 'Craft Studio', desc: 'Handmade leather goods & accessories.', price: '120,000', icon: '👜', type: 'Crafts' },
            { name: 'Fresh Greens', desc: 'Hydroponic vegetables from our hub farm.', price: '25,000', icon: '🥬', type: 'Farm' },
            { name: 'Tech Repair', desc: 'Electronics repair & node setup service.', price: '75,000', icon: '🔧', type: 'Service' },
            { name: 'Orange Apparel', desc: 'Limited edition Bitcoin merch & tees.', price: '85,000', icon: '👕', type: 'Retail' },
            { name: 'Wellness Spa', desc: 'Massage & recovery sessions.', price: '150,000', icon: '💆', type: 'Wellness' }
        ];

        const marketGrid = document.getElementById('market-grid');
        vendors.forEach(v => {
            const card = document.createElement('div');
            card.className = 'vendor-card glass rounded-2xl p-6 border border-white/5 cursor-pointer';
            card.innerHTML = `
                <div class="flex justify-between items-start mb-4">
                    <div class="w-12 h-12 rounded-xl bg-white/5 flex items-center justify-center text-2xl">${v.icon}</div>
                    <span class="px-2 py-1 rounded-md bg-btc-orange/10 text-btc-orange text-xs font-medium">${v.type}</span>
                </div>
                <h3 class="font-semibold text-lg mb-1">${v.name}</h3>
                <p class="text-sm text-gray-400 mb-4 h-10">${v.desc}</p>
                <div class="flex items-center justify-between pt-4 border-t border-white/5">
                    <div>
                        <div class="text-xs text-gray-500">Price</div>
                        <div class="font-bold text-btc-orange">₿ ${v.price} SATS</div>
                    </div>
                    <button class="px-3 py-1.5 rounded-lg bg-white/5 hover:bg-btc-orange hover:text-white transition-colors text-sm font-medium">Pay w/ LN</button>
                </div>
            `;
            marketGrid.appendChild(card);
        });
    </script>
