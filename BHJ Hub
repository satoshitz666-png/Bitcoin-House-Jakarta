    <!-- Mining Farm Dummy -->
    <section id="mining" class="py-24 bg-btc-dark relative">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="text-center mb-12 fade-in">
                <h2 class="text-4xl font-bold mb-4">Mining Farm <span class="text-btc-orange">Simulator</span></h2>
                <p class="text-gray-400 max-w-2xl mx-auto">Educational dummy interface demonstrating Proof of Work, energy efficiency, and network security. Not real mining.</p>
            </div>
            <div class="glass rounded-3xl p-6 md:p-8 border border-white/10 fade-in">
                <div class="grid lg:grid-cols-3 gap-8">
                    <!-- Controls -->
                    <div class="lg:col-span-1 space-y-6">
                        <div>
                            <label class="block text-sm font-medium text-gray-400 mb-2">Hashrate Allocation (TH/s)</label>
                            <input type="range" id="hashrate-slider" min="0" max="100" value="40" class="w-full h-2 bg-btc-light rounded-lg appearance-none cursor-pointer accent-btc-orange">
                            <div class="flex justify-between text-xs text-gray-500 mt-1">
                                <span>0</span><span id="hashrate-display">40 TH/s</span><span>100</span>
                            </div>
                        </div>
                        <div>
                            <label class="block text-sm font-medium text-gray-400 mb-2">Energy Efficiency Mode</label>
                            <div class="flex gap-2">
                                <button onclick="setEfficiency('eco')" class="eff-btn flex-1 py-2 rounded-lg border border-white/10 text-sm hover:bg-white/5 transition-colors focus:ring-2 focus:ring-btc-orange">Eco</button>
                                <button onclick="setEfficiency('balanced')" class="eff-btn flex-1 py-2 rounded-lg border border-btc-orange bg-btc-orange/20 text-sm text-btc-orange transition-colors focus:ring-2 focus:ring-btc-orange">Balanced</button>
                                <button onclick="setEfficiency('turbo')" class="eff-btn flex-1 py-2 rounded-lg border border-white/10 text-sm hover:bg-white/5 transition-colors focus:ring-2 focus:ring-btc-orange">Turbo</button>
                            </div>
                        </div>
                        <button id="mining-toggle" onclick="toggleMining()" class="w-full py-3 rounded-xl bg-btc-orange text-white font-semibold hover:bg-orange-600 transition-all shadow-lg shadow-orange-500/20 flex items-center justify-center gap-2">
                            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14.752 11.168l-3.197-2.132A1 1 0 0010 9.87v4.263a1 1 0 001.555.832l3.197-2.132a1 1 0 000-1.664z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
                            Start Simulation
                        </button>
                    </div>

                    <!-- Dashboard -->
                    <div class="lg:col-span-2 grid grid-cols-2 gap-4">
                        <div class="bg-btc-light rounded-2xl p-5 border border-white/5">
                            <div class="text-sm text-gray-400 mb-1">Active Hashrate</div>
                            <div class="text-2xl font-bold text-white"><span id="dash-hash">0.00</span> <span class="text-sm text-gray-500">TH/s</span></div>
                            <div class="w-full bg-btc-dark rounded-full h-2 mt-3 overflow-hidden">
                                <div id="bar-hash" class="h-full bg-btc-orange mining-bar" style="width: 0%"></div>
                            </div>
                        </div>
                        <div class="bg-btc-light rounded-2xl p-5 border border-white/5">
                            <div class="text-sm text-gray-400 mb-1">Power Consumption</div>
                            <div class="text-2xl font-bold text-white"><span id="dash-power">0.0</span> <span class="text-sm text-gray-500">kW</span></div>
                            <div class="w-full bg-btc-dark rounded-full h-2 mt-3 overflow-hidden">
                                <div id="bar-power" class="h-full bg-accent-blue mining-bar" style="width: 0%"></div>
                            </div>
                        </div>
                        <div class="bg-btc-light rounded-2xl p-5 border border-white/5">
                            <div class="text-sm text-gray-400 mb-1">Blocks Found (Sim)</div>
                            <div class="text-2xl font-bold text-accent-green" id="dash-blocks">0</div>
                            <div class="text-xs text-gray-500 mt-2">Target: 100 blocks</div>
                            <div class="w-full bg-btc-dark rounded-full h-2 mt-2 overflow-hidden">
                                <div id="bar-blocks" class="h-full bg-accent-green mining-bar" style="width: 0%"></div>
                            </div>
                        </div>
                        <div class="bg-btc-light rounded-2xl p-5 border border-white/5">
                            <div class="text-sm text-gray-400 mb-1">Network Security</div>
                            <div class="text-2xl font-bold text-white flex items-center gap-2">
                                <span id="dash-sec">Secure</span>
                                <svg class="w-5 h-5 text-accent-green" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/></svg>
                            </div>
                            <div class="text-xs text-gray-500 mt-2">PoW Consensus Active</div>
