                <svg class="w-6 h-6 text-btc-orange" fill="currentColor" viewBox="0 0 24 24"><path d="M22.84 13.58c.28-1.88-.76-2.88-2.12-3.34l.43-1.72-1.06-.26-.41 1.66c-.28-.07-.57-.14-.85-.21l.42-1.68-1.06-.26-.43 1.73c-.23-.05-.45-.11-.67-.16l.01-.04-1.46-.37-.28 1.12s.79.18.77.19c.43.11.51.39.49.61l-.5 2c.03.01.07.02.11.04l-.11-.03-.7 2.81c-.05.13-.18.32-.47.25.01.01-.77-.19-.77-.19l-.53 1.22 1.38.34c.26.06.51.13.76.2l-.44 1.77 1.06.26.43-1.72c.29.08.57.15.84.22l-.42 1.7 1.06.26.44-1.77c1.8.34 3.15.2 3.72-1.43.46-1.31-.02-2.07-1.02-2.52.72-.17 1.27-.64 1.41-1.62zM17.3 15.3c-.34 1.37-2.64.63-3.38.45l.6-2.42c.74.19 3.13.55 2.78 1.97zm.34-3.42c-.31 1.25-2.24.62-2.86.47l.55-2.2c.62.15 2.62.43 2.31 1.73z"/></svg>
