    <!-- SATS Market -->
    <section id="sats-market" class="py-24 bg-btc-surface relative">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="flex flex-col md:flex-row justify-between items-end mb-12 fade-in">
                <div>
                    <h2 class="text-4xl font-bold mb-2">SATS <span class="text-btc-orange">Market</span></h2>
                    <p class="text-gray-400 max-w-xl">Circular economy for local MSMEs. Trade goods and services peer-to-peer using Lightning Network. No intermediaries.</p>
